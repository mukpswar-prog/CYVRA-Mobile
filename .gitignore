# dependencies
node_modules/
.pnpm-store/

# build output
dist/
.wrangler/
.vite/
*.tsbuildinfo

# env / secrets (never commit real values)
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
!.dev.vars.example

# local Postgres data (Neon stand-in for local dev)
.cyvra-pgdata/

# IDE (never commit; Studio/Cursor create these locally)
.idea/
apps/android/.idea/

# Android / Gradle
apps/android/.gradle/
apps/android/.kotlin/
apps/android/**/build/
apps/host/.gradle/
apps/host/.kotlin/
apps/host/build/
# jqwik's shrink-failure database. Local tooling state, never source.
apps/host/.jqwik-database
apps/android/local.properties
apps/android/.idea/
# Studio/Gradle 9 "updateDaemonJvm" writes this and can pin JDK 25.
# Freeze is JDK 21. Do not commit it.
apps/android/gradle/gradle-daemon-jvm.properties
# TASK O probe fixtures: content captured locally, never committed or pushed.
# Governed doc section 9 - fixtures stay local; no egress.
# Chief Engineer ruling 09-Oct-2026 (TASK Q): this repository is PUBLIC, so real-
# device fixture content - BSSID/MAC location data and a personal app inventory
# (DPDP Act 2023) - must not egress. Only the hash manifest MANIFEST.md is tracked;
# it records path/bytes/sha256 so fixture existence stays verifiable without content.
# NOTE: the directory itself must NOT be ignored, or git will refuse to re-include
# MANIFEST.md; ignore its contents instead.
apps/android/core/src/test/fixtures/*
!apps/android/core/src/test/fixtures/MANIFEST.md

# ------------------------------------------------------------------------------
# Signing key material - never committed.
#
# Ruling (Chief Engineer, 10-Oct-2026): Ed25519 / APK signing key custody is
# DEFERRED (R-I). No key may be generated, used, or published until the custody
# ruling lands.
#
# This block is PREVENTIVE, not a cleanup. Nothing matching it is tracked today
# (verified: zero matches across git ls-files). Its purpose is that if a keystore
# does appear on a developer machine during WP-2 or any later work package, git
# refuses it outright instead of letting a private key ride into a PUBLIC
# repository. The failure mode this prevents is silent and irreversible.
#
# Deliberately NOT ignored: *.pem, *.crt, *.cer, *.der - these commonly hold
# PUBLIC certificates, which the product will legitimately need to commit.
# ------------------------------------------------------------------------------
*.jks
*.keystore
*.pepk
*.pk8
*.p12
*.pfx
*.key
keystore.properties
signing.properties
*.keystore.properties

# logs / os
*.log
.DS_Store
