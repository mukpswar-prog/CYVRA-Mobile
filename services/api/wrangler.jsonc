{
  // CYVRA Mobile Evidence API — Cloudflare Worker `cyvra-mobile-api`.
  // New resource only; never reuse cyvoriq-erase-api / cyvra-approvals.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cyvra-mobile-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Keep workers.dev so CI can health-check without the custom-domain
  // bot challenge. Product traffic is api.cyvoriq.co.in.
  "workers_dev": true,
  "hyperdrive": [
    {
      // Bind Neon project floral-art-02749206 (pooled URL) via Hyperdrive
      // `cyvra-mobile-neon` (id is the live config; not a secret).
      // localConnectionString is wrangler-dev only.
      "binding": "HYPERDRIVE",
      "id": "db31fc8dafca49b29172da7046b97175",
      "localConnectionString": "postgres://cyvra:cyvra@127.0.0.1:5432/cyvra_mobile"
    }
  ],
  // Single source of truth for deploy-time vars: the dashboard already reads
  // API_ENV as "production", and the deploy workflow no longer passes --var
  // overrides. Local `wrangler dev` still gets localhost:5173 from APP_ORIGIN.
  "vars": {
    // TODO: must move to "https://cyvoriq.co.in" once the customer web Pages
    // project goes live; until then the CORS allow-list is keyed on localhost.
    "APP_ORIGIN": "http://localhost:5173",
    "API_ENV": "production"
  },
  // New product hostname only. Never api.cyvra.co.in or mobile.cyvra.co.in.
  "routes": [
    {
      "pattern": "api.cyvoriq.co.in",
      "custom_domain": true,
      "zone_name": "cyvoriq.co.in"
    }
  ]
}
