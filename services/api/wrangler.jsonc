{
  // CYVRA Mobile Evidence API — Cloudflare Worker `cyvra-mobile-api`.
  // New resource only; never reuse cyvoriq-erase-api / cyvra-approvals.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cyvra-mobile-api",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-27",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "hyperdrive": [
    {
      // Bind Neon project floral-art-02749206 (pooled URL) via Hyperdrive
      // `cyvra-mobile-neon`. `id` stays the 32-zero placeholder until a
      // logged-in session runs `scripts/g1-cloud-preview.sh` (wrangler is not
      // authenticated in this environment). `localConnectionString` points
      // wrangler dev at the workspace Postgres cluster.
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgres://cyvra:cyvra@127.0.0.1:5432/cyvra_mobile"
    }
  ],
  "vars": {
    "APP_ORIGIN": "http://localhost:5173",
    "API_ENV": "development"
  }
}
