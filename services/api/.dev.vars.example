# Worker secrets for local dev (never commit real values). Copy to `.dev.vars`.
# When RESEND_API_KEY is unset (or API_ENV is not production and Resend rejects
# an unverified domain) the Worker does NOT email: it returns the OTP in JSON
# so local / Pages preview can complete without a verified Resend domain.
RESEND_API_KEY=
RESEND_FROM="CYVRA Mobile <noreply@cyvra.co.in>"
SESSION_SECRET=local-dev-session-secret-change-me
