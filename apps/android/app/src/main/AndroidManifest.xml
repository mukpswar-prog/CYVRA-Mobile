<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Declared here; requested only when the matching test starts (guideline §8.2). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- minSdk 26: pre-31 Bluetooth names. BLUETOOTH_CONNECT is API 31+. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- API 33+. Older Android ignores this name; do not treat it as universal. -->
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" />
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <application
        android:allowBackup="false"
        android:label="CYVRA Mobile Evidence"
        android:supportsRtl="true"
        android:theme="@style/Theme.CyvraMobile">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".ComponentEvidenceReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="co.in.cyvra.mobile.COLLECT_EVIDENCE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
