<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        BIND_DEVICE_ADMIN is deliberately NOT declared with <uses-permission>.

        It is a signature-level permission that is only ever granted to system apps, so
        a <uses-permission> entry would grant this app nothing at all — Lint rejects it
        as ProtectedPermissions, and it would still be a no-op if Lint were silenced.

        What actually protects the admin receiver is the android:permission attribute on
        that receiver below, which the system enforces at bind time regardless of any
        declaration here.
    -->

    <!--
        android:testOnly="true" must be present BEFORE `dpm set-device-owner` runs.

        Android refuses `dpm remove-active-admin` for any admin whose application did
        not declare itself test-only, so without this attribute the module becomes a
        Device Owner that can be cleared only by factory-resetting the device.

        Declared here it ensures:
          - the admin is releasable with `dpm remove-active-admin` when needed during
            non-destructive bench verification; and
          - the APK requires explicit `-t` ADB staging and cannot be installed by a
            user tapping an APK file.
    -->
    <application
        android:allowBackup="false"
        android:label="CYVRA Sanitization"
        android:supportsRtl="true"
        android:testOnly="true"
        android:theme="@android:style/Theme.Material.Light">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            The device-admin component. Guarded by BIND_DEVICE_ADMIN, so it can only be
            driven by the system that binds it.
        -->
        <receiver
            android:name=".SanitizationAdmin"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!--
            HARDENED SANITIZATION RECEIVER (DEF-02 Rectification, 2026-10-31).

            Guarded at the Android OS framework boundary by `android.permission.DUMP`,
            an AOSP signature|privileged|development permission held by `com.android.shell`
            (UID 2000, which executes authenticated workstation ADB commands) and
            unobtainable by any third-party application installed on the device.

            Additionally enforced inside SanitizationBroadcastReceiver:
              1. Two-phase ARM -> WIPE protocol with 60s TTL and single-use consumption.
              2. Minimum 32-character cryptographic token entropy requirement.
              3. Session UUID, Operation ID, Target Serial, and Build Fingerprint binding
                 verified immediately prior to DevicePolicyManager.wipeData(0).
        -->
        <receiver
            android:name=".SanitizationBroadcastReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.cyvra.sanitization.HANDSHAKE" />
                <action android:name="com.cyvra.sanitization.ASSESS" />
                <action android:name="com.cyvra.sanitization.ARM" />
                <action android:name="com.cyvra.sanitization.WIPE" />
                <action android:name="com.cyvra.sanitization.DISARM" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
