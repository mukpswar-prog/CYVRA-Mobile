{
  "name": "cyvra-mobile",
  "version": "0.0.0",
  "private": true,
  "description": "CYVRA Mobile Evidence — monorepo (customer web + Cloudflare Worker API + Neon/Drizzle database).",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24.21.0",
    "npm": ">=12.0.2",
    "pnpm": ">=12.3.4"
  },
  "scripts": {
    "dev": "pnpm run --parallel --filter @cyvra/api --filter @cyvra/web dev",
    "dev:api": "pnpm --filter @cyvra/api dev",
    "dev:web": "pnpm --filter @cyvra/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test:evidence": "pnpm --filter @cyvra/evidence test",
    "test:api-origins": "pnpm --filter @cyvra/api test",
    "db:generate": "pnpm --filter @cyvra/database generate",
    "db:migrate": "pnpm --filter @cyvra/database migrate",
    "db:migrate:neon": "bash scripts/migrate-neon.sh",
    "deploy:api-preview": "bash scripts/deploy-api-preview.sh",
    "deploy:www-cyvoriq": "bash scripts/deploy-www-cyvoriq.sh",
    "test:local-auth": "bash scripts/test-local-auth.sh",
    "test:local-evidence": "bash scripts/run-local-evidence.sh",
    "test:local-report": "bash scripts/run-local-report.sh",
    "test:local-admin-serials": "bash scripts/run-local-admin-serials.sh"
  }
}
